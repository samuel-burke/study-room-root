# Copy to server/.env and paste the dev token from https://dev.rootapp.com
# Never commit the real file. It is ignored by .gitignore.
DEV_TOKEN=your-dev-token-here

# Optional: where Send feedback notes go. Baked into server/dist by the build,
# because Root has no secret storage. Leave both pairs empty to hide the box.
# Issues in a private repo (fine-grained token: that repo only, Issues read/write):
FEEDBACK_GITHUB_TOKEN=
FEEDBACK_GITHUB_REPO=
# Or email through Resend (https://resend.com), to your Resend account's email:
FEEDBACK_RESEND_KEY=
FEEDBACK_EMAIL=
