                {
                  "key": "15",
                  "value": "15 people"
                },
                {
                  "key": "20",
                  "value": "20 people"
                }
              ]
            }
          }
        ]
      },
      {
        "key": "game",
        "title": "Game layer",
        "items": [
          {
            "key": "xpEnabled",
            "title": "XP and levels",
            "description": "2 XP per focus minute, +25 per finished goal.",
            "checkbox": {
              "defaultValue": true
            }
          },
          {
            "key": "dailyXpCap",
            "title": "Daily XP cap",
            "description": "So nobody burns out chasing XP.",
            "select": {
              "multiSelect": false,
              "values": ["300"],
              "options": [
                {
                  "key": "150",
                  "value": "150 XP"
                },
                {
                  "key": "200",
                  "value": "200 XP"
                },
                {
                  "key": "300",
                  "value": "300 XP"
                },
                {
                  "key": "400",
                  "value": "400 XP"
                },
                {
                  "key": "500",
                  "value": "500 XP"
                },
                {
                  "key": "1000",
                  "value": "1000 XP"
                }
              ]
            }
          },
          {
            "key": "comboEnabled",
            "title": "Combo multiplier",
            "description": "More people on the room timer means more XP for all.",
            "checkbox": {
              "defaultValue": true
            }
          },
          {
            "key": "bossEnabled",
            "title": "Weekly boss",
            "description": "A community goal with an HP bar. Every focus minute deals damage. A new boss spawns every Monday.",
            "checkbox": {
              "defaultValue": true
            }
          },
          {
            "key": "bossName",
            "title": "Boss name",
            "description": "Shown on the boss card and in posts.",
            "text": {
              "defaultValue": "Midterms",
              "regex": "^.{1,40}$"
            }
          },
          {
            "key": "bossHpHours",
            "title": "Boss HP (focus hours)",
            "description": "Suggested: 15 hours per active member.",
            "select": {
              "multiSelect": false,
              "values": ["100"],
              "options": [
                {
                  "key": "10",
                  "value": "10 hours"
                },
                {
                  "key": "25",
                  "value": "25 hours"
                },
                {
                  "key": "50",
                  "value": "50 hours"
                },
                {
                  "key": "75",
                  "value": "75 hours"
                },
                {
                  "key": "100",
                  "value": "100 hours"
                },
                {
                  "key": "150",
                  "value": "150 hours"
                },
                {
                  "key": "200",
                  "value": "200 hours"
                },
                {
                  "key": "300",
                  "value": "300 hours"
                },
                {
                  "key": "500",
                  "value": "500 hours"
                },
                {
                  "key": "1000",
                  "value": "1000 hours"
                }
              ]
            }
          },
          {
            "key": "streakFreezes",
            "title": "Streak freezes",
            "description": "One free missed day per week.",
            "checkbox": {
              "defaultValue": true
            }
          },
          {
            "key": "milestonePosts",
            "title": "Milestone posts",
            "description": "Celebrate 7, 30, 50, 100 and 365 day streaks in the post channel.",
            "checkbox": {
              "defaultValue": true
            }
          },
          {
            "key": "afkChecks",
            "title": "AFK checks",
            "description": "Ask for one tap at a random moment in focus blocks of 25 minutes or more. A missed tap still counts the minutes, but not the combo or streak.",
            "checkbox": {
              "defaultValue": true
            }
          }
        ]
      }
    ]
  }
