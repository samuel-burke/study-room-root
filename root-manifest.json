{
  "id": "your-app-id",
  "version": "0.1.0",
  "package": {
    "client": {
      "deploy": "client/dist"
    },
    "server": {
      "launch": "server/dist/main.js",
      "deploy": [
        "server/dist",
        "networking/gen/server",
        "core/dist",
        "core/package.json",
        "contract/dist",
        "contract/package.json"
      ],
      "nodeModules": ["node_modules"]
    }
  },
  "permissions": {
    "channel": {
      "channelView": true,
      "channelCreateMessage": true
    }
  },
  "settings": {
    "groups": [
      {
        "key": "room",
        "title": "Timer and room",
        "items": [
          {
            "key": "timerPreset",
            "title": "Default room timer",
            "description": "Focus minutes / break minutes. Rounds of 4, then a long break. Changes apply from the next cycle.",
            "select": {
              "multiSelect": false,
              "values": ["25-5"],
              "options": [
                {
                  "key": "25-5",
                  "value": "25 / 5"
                },
                {
                  "key": "50-10",
                  "value": "50 / 10"
                },
                {
                  "key": "custom",
                  "value": "Custom"
                }
              ]
            }
          },
          {
            "key": "customFocusMinutes",
            "title": "Custom focus minutes",
            "description": "Used when the room timer is set to Custom.",
            "select": {
              "multiSelect": false,
              "values": ["25"],
              "options": [
                {
                  "key": "15",
                  "value": "15 min"
                },
                {
                  "key": "20",
                  "value": "20 min"
                },
                {
                  "key": "25",
                  "value": "25 min"
                },
                {
                  "key": "30",
                  "value": "30 min"
                },
                {
                  "key": "40",
                  "value": "40 min"
                },
                {
                  "key": "45",
                  "value": "45 min"
                },
                {
                  "key": "50",
                  "value": "50 min"
                },
                {
                  "key": "60",
                  "value": "60 min"
                },
                {
                  "key": "75",
                  "value": "75 min"
                },
                {
                  "key": "90",
                  "value": "90 min"
                },
                {
                  "key": "120",
                  "value": "120 min"
                }
              ]
            }
          },
          {
            "key": "customBreakMinutes",
            "title": "Custom break minutes",
            "description": "Used when the room timer is set to Custom.",
            "select": {
              "multiSelect": false,
              "values": ["5"],
              "options": [
                {
                  "key": "3",
                  "value": "3 min"
                },
                {
                  "key": "5",
                  "value": "5 min"
                },
                {
                  "key": "10",
                  "value": "10 min"
                },
                {
                  "key": "15",
                  "value": "15 min"
                },
                {
                  "key": "20",
                  "value": "20 min"
                },
                {
                  "key": "30",
                  "value": "30 min"
                }
              ]
            }
          },
          {
            "key": "postChannel",
            "title": "Post updates in",
            "description": "Daily recaps, busy-room and milestone posts go here. Leave empty to turn posts off.",
            "channel": {
              "multiSelect": false
            }
          },
          {
            "key": "recapEnabled",
            "title": "Daily recap",
            "description": "Post community hours, goals finished and top streaks once a day.",
            "checkbox": {
              "defaultValue": true
            }
          },
          {
            "key": "recapTime",
            "title": "Recap time",
            "description": "In the community time zone below.",
            "time": {
              "defaultValue": {
                "hours": 21,
                "minutes": 0,
                "seconds": 0
              }
            }
          },
          {
            "key": "timeZone",
            "title": "Community time zone",
            "description": "Decides when a day starts for streaks, recaps and the weekly boss.",
            "select": {
              "multiSelect": false,
              "values": ["America/New_York"],
              "options": [
                {
                  "key": "America/New_York",
                  "value": "America/New York"
                },
                {
                  "key": "America/Chicago",
                  "value": "America/Chicago"
                },
                {
                  "key": "America/Denver",
                  "value": "America/Denver"
                },
                {
