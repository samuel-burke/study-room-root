                },
                {
                  "key": "America/Anchorage",
                  "value": "America/Anchorage"
                },
                {
                  "key": "Pacific/Honolulu",
                  "value": "Pacific/Honolulu"
                },
                {
                  "key": "America/Toronto",
                  "value": "America/Toronto"
                },
                {
                  "key": "America/Sao_Paulo",
                  "value": "America/Sao Paulo"
                },
                {
                  "key": "Europe/London",
                  "value": "Europe/London"
                },
                {
                  "key": "Europe/Berlin",
                  "value": "Europe/Berlin"
                },
                {
                  "key": "Europe/Paris",
                  "value": "Europe/Paris"
                },
                {
                  "key": "Europe/Madrid",
                  "value": "Europe/Madrid"
                },
                {
                  "key": "Africa/Lagos",
                  "value": "Africa/Lagos"
                },
                {
                  "key": "Africa/Johannesburg",
                  "value": "Africa/Johannesburg"
                },
                {
                  "key": "Asia/Kolkata",
                  "value": "Asia/Kolkata"
                },
                {
                  "key": "Asia/Singapore",
                  "value": "Asia/Singapore"
                },
                {
                  "key": "Asia/Tokyo",
                  "value": "Asia/Tokyo"
                },
                {
                  "key": "Asia/Seoul",
                  "value": "Asia/Seoul"
                },
                {
                  "key": "Australia/Sydney",
                  "value": "Australia/Sydney"
                },
                {
                  "key": "Pacific/Auckland",
                  "value": "Pacific/Auckland"
                },
                {
                  "key": "UTC",
                  "value": "UTC"
                }
              ]
            }
          },
          {
            "key": "goalsPublicByDefault",
            "title": "Show goals by default",
            "description": "Members can always switch theirs to private.",
            "checkbox": {
              "defaultValue": true
            }
          },
          {
            "key": "busyPosts",
            "title": "\"Room is busy\" posts",
            "description": "Post once when enough people are focusing at the same time.",
            "checkbox": {
              "defaultValue": true
            }
          },
          {
            "key": "busyThreshold",
            "title": "Busy room threshold",
            "description": "How many people focusing counts as busy.",
            "select": {
              "multiSelect": false,
              "values": ["5"],
              "options": [
                {
                  "key": "3",
                  "value": "3 people"
                },
                {
                  "key": "4",
                  "value": "4 people"
                },
                {
                  "key": "5",
                  "value": "5 people"
                },
                {
                  "key": "6",
